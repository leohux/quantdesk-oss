ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# SiliconFlow (硅基流动) — shared OpenAI-compatible endpoint
SILICONFLOW_API_KEY=

# News AI scorer (SiliconFlow DeepSeek V4-Flash — fast, parallel)
# Reuses SILICONFLOW_API_KEY via DEEPSEEK_API_KEY=... in deploy, or set both.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
NEWS_TRADER_MODEL=deepseek-ai/DeepSeek-V4-Flash
NEWS_TRADER_PRO_MODEL=deepseek-ai/DeepSeek-V4-Pro

# News trader (docker-compose news-trader service also sets these)
# SCORE_WHEN_CLOSED=1 scores overnight/premarket and queues buys for the open
# MAX_ENTRY_VS_NEWS_PCT skips if price already ran vs news bar / prev close
# NEWS_TRADER_MAX_POSITIONS=8
# NEWS_TRADER_PCT_EQUITY=0.03
# NEWS_TRADER_MAX_NOTIONAL=4000
# NEWS_TRADER_MAX_BUYS=3
# NEWS_TRADER_INTERVAL_SEC=15
# NEWS_TRADER_OFF_HOURS_SEC=45
# NEWS_TRADER_SEC_POLL_SEC=15
# NEWS_TRADER_SCORE_WORKERS=4
# NEWS_TRADER_SCORE_TIMEOUT_SEC=30
# NEWS_TRADER_ESCALATE_PRO=1
# NEWS_TRADER_EDGE_CONF_LO=0.65
# NEWS_TRADER_EDGE_CONF_HI=0.75
# NEWS_TRADER_PRO_TIMEOUT_SEC=60
# NEWS_TRADER_SCORE_WHEN_CLOSED=1
# NEWS_TRADER_MAX_ENTRY_VS_NEWS_PCT=2.0
# NEWS_TRADER_MAX_NEWS_AGE_SEC=14400
# Premarket DAY limits (no open market chase): aggress toward chase ceiling
# NEWS_TRADER_PREMARKET_LIMITS=1
# NEWS_TRADER_PREMARKET_LIMIT_AGGRESS_BPS=25
# NEWS_TRADER_PREMARKET_NEAR_OPEN_MIN=45
# NEWS_TRADER_PREMARKET_NEAR_OPEN_AGGRESS_BPS=80
# NEWS_TRADER_PREMARKET_REPRICE_BPS=15

# Research agents pipeline (SiliconFlow DeepSeek)
QUANTDESK_AGENT_BASE_URL=https://api.siliconflow.cn/v1
QUANTDESK_AGENT_MODEL=deepseek-ai/DeepSeek-V4-Pro

DATA_PROVIDER=auto
DEFAULT_SYMBOL=AAPL
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
ACCESS_TOKEN=
SETUP_TOKEN=quantdesk-setup
# REQUIRED: Web / JWT login password (api jwt-login + core.auth admin user).
# No insecure default — the API will refuse to start/login without this.
ADMIN_PASSWORD=change-me-to-a-strong-password
# Optional viewer role (defaults to ADMIN_PASSWORD if unset)
# VIEWER_PASSWORD=
# Optional: alpha miner API login (falls back to ADMIN_PASSWORD)
ALPHA_MINER_PASSWORD=
# Optional: Financial Modeling Prep (research scripts only)
# FMP_API_KEY=
POSTGRES_URL=postgresql://quantdesk:quantdesk@postgres:5432/quantdesk
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
FAST_MA=20
SLOW_MA=60
RISK_PER_TRADE_PCT=2.0
MAX_POSITION_PCT=20.0

# Account-level paper book cap (gross MV / equity). Cash floor defaults to 100-gross.
MAX_GROSS_EXPOSURE_PCT=150
PORTFOLIO_GROSS=1.5
MIN_CASH_PCT=-50

# IBKR live / paper gateway
IBKR_USERNAME=
IBKR_PASSWORD=
IBKR_ACCOUNT=
IBKR_ALLOWED_ACCOUNTS=
IBKR_HOST=ibkr-gateway
IBKR_PORT=4002
IBKR_CLIENT_ID=101
IBKR_GATEWAY_MODE=paper
IBKR_TRADING_MODE=paper
IBKR_READ_ONLY=true
IBKR_CONNECT_TIMEOUT_SEC=8
IBKR_RECONNECT_BACKOFF_SEC=5
IBKR_MARKET_DATA_FRESHNESS_SEC=120

# Live fail-closed locks
QUANT_MODE=live_locked
LIVE_TRADING_ENABLED=false
LIVE_EXECUTION_ARMED=false
LIVE_REQUIRE_ADMIN_ROLE=true
LIVE_ARMING_TOKEN=
LIVE_ALLOWED_SYMBOLS=
LIVE_ALLOWED_SIDES=buy,sell
LIVE_MAX_ORDER_VALUE_USD=1000
LIVE_MAX_POSITION_PCT=5
LIVE_MAX_EXPOSURE_PCT=25
LIVE_MAX_DAILY_LOSS_PCT=2
LIVE_MAX_DRAWDOWN_PCT=8
LIVE_MIN_CASH_PCT=25
LIVE_MAX_OPEN_ORDERS=6
LIVE_ONLY_REDUCE_EXISTING=true
LIVE_ALLOW_SHORT=false
LIVE_ALLOW_MARGIN=false
LIVE_ALLOW_EXTENDED_HOURS=false
